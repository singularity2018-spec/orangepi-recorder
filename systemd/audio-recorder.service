[Unit]
Description=Orange Pi Audio Recorder
After=sound.target
Wants=sound.target

[Service]
Type=simple
User=recorder
Group=recorder
SupplementaryGroups=audio
UMask=0002
EnvironmentFile=/etc/orangepi-recorder/audio-recorder.env
ExecStart=/opt/orangepi-recorder/bin/audio-recorder.sh
Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=60
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/records /etc/orangepi-recorder

[Install]
WantedBy=multi-user.target
